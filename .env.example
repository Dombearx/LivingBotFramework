# Copy this file to .env and fill in your own values.

# Discord bot token used to connect the bot and the admin dashboard.
DISCORD_BOT_TOKEN=

# OpenRouter API key for all LLM calls.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter base URL (defaults to the public endpoint).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RunPod API key for image generation (selfies and photos).
RUNPOD_API_KEY=

# Optional: Logfire write token for observability.
LOGFIRE_TOKEN=

# Absolute path to this repository's checkout on the deployment host. Required
# by the update-server service in docker-compose.yml, which bind-mounts the
# checkout and the docker socket to pull and redeploy on request.
REPO_PATH=
