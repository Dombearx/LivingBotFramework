# Copy this file to .env and fill in your own values.

# Discord bot token used to connect the bot and the admin dashboard.
DISCORD_BOT_TOKEN=

# OpenRouter API key for all LLM calls.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter base URL (defaults to the public endpoint).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI API key for the memory subsystem (mem0 talks to OpenAI directly for
# embeddings and its own LLM calls, independent of OPENROUTER_API_KEY above).
OPENAI_API_KEY=

# RunPod API key for image generation (selfies and photos).
RUNPOD_API_KEY=
