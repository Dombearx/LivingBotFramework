# Copy this file to .env and fill in your own values.

# Discord bot token used to connect the bot and the admin dashboard.
DISCORD_BOT_TOKEN=

# OpenRouter API key for all LLM calls.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter base URL (defaults to the public endpoint).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RunPod API key, used by the image generation service.
RUNPOD_API_KEY=

# Optional: where the image generation service listens, and where the bot looks
# for it. docker compose sets the bot's URL itself; these only matter when
# running either side outside compose.
# IMAGE_SERVICE_PORT=8000
# IMAGE_SERVICE_URL=http://localhost:8100

# Optional: Logfire write token for observability.
LOGFIRE_TOKEN=
